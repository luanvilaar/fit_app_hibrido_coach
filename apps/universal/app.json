{
  "expo": {
    "name": "FitBlock Training",
    "slug": "fitblock-training",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "fitblock",
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/fitblock-mark.png"
    },
    "assetBundlePatterns": ["**/*"]
  }
}
