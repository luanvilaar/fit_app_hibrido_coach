{
  "name": "fitblock-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/universal",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/with-root-env.cjs start",
    "dev": "node scripts/with-root-env.cjs start --web",
    "web": "node scripts/with-root-env.cjs start --web",
    "lint": "eslint api packages && npm --workspace @fitblock/universal run lint",
    "typecheck": "tsc --noEmit",
    "test": "npm --workspace @fitblock/universal run test",
    "verify:schema": "node scripts/verify-schema.mjs",
    "build": "node scripts/with-root-env.cjs export --platform web"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "@types/react-native": "0.73.0",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "9.39.1",
    "jest": "29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@radix-ui/react-slot": "1.2.0",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-font": "~14.0.12",
    "expo-router": "~6.0.24",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "0.21.2",
    "resend": "^6.20.0",
    "standardwebhooks": "^1.0.0"
  }
}
